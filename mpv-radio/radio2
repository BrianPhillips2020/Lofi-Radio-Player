#!/usr/bin/env python3
"""Textual TUI wrapper around mpv for streaming audio from preset URLs."""

import json
import os
import socket
import subprocess
import tempfile

from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.containers import Horizontal
from textual.widgets import Button, Footer, Header, Static

STREAMS = {
    "lofi radio beats": "https://www.youtube.com/watch?v=X4VbdwhkE10",
    "synthwave beats": "https://www.youtube.com/watch?v=4xDzrJKXOOY",
}
STREAM_ITEMS = list(STREAMS.items())


class MpvController:
    """Runs mpv as a subprocess and drives it over its JSON IPC socket."""

    def __init__(self) -> None:
        self.process: subprocess.Popen | None = None
        self.socket_path: str | None = None
        self.paused = False

    @property
    def is_playing(self) -> bool:
        return self.process is not None and self.process.poll() is None

    def play(self, url: str) -> None:
        self.stop()
        fd, self.socket_path = tempfile.mkstemp(prefix="mpv-radio-", suffix=".sock")
        os.close(fd)
        os.unlink(self.socket_path)
        self.process = subprocess.Popen(
            ["mpv", "--no-video", f"--input-ipc-server={self.socket_path}", url],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL,
        )
        self.paused = False

    def _send(self, command: list) -> None:
        if not self.socket_path or not self.is_playing:
            return
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                sock.connect(self.socket_path)
                sock.sendall((json.dumps({"command": command}) + "\n").encode())
        except OSError:
            pass

    def toggle_pause(self) -> None:
        if not self.is_playing:
            return
        self._send(["cycle", "pause"])
        self.paused = not self.paused

    def stop(self) -> None:
        if self.process is not None:
            if self.process.poll() is None:
                self.process.terminate()
                try:
                    self.process.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    self.process.kill()
            self.process = None
        if self.socket_path and os.path.exists(self.socket_path):
            os.unlink(self.socket_path)
        self.socket_path = None
        self.paused = False


class RadioApp(App):
    CSS = """
    Screen {
        align: center middle;
    }
    #status {
        height: 3;
        content-align: center middle;
        border: round $accent;
        margin: 1 2;
    }
    #stream-buttons {
        height: auto;
        align: center middle;
    }
    #stream-buttons Button {
        margin: 0 1;
    }
    """

    BINDINGS = [
        Binding("space", "toggle_pause", "Pause/Resume"),
        Binding("s", "stop", "Stop"),
        Binding("q", "quit", "Quit"),
    ]

    def __init__(self) -> None:
        super().__init__()
        self.mpv = MpvController()
        self.current_name: str | None = None
        self.current_index = 0

    def on_mount(self) -> None:
        self.play_index(0)

    def compose(self) -> ComposeResult:
        yield Header()
        yield Static("Nothing playing", id="status")
        with Horizontal(id="stream-buttons"):
            yield Button("◀ Prev", id="prev")
            yield Button("Next ▶", id="next")
        yield Footer()

    def play_index(self, index: int) -> None:
        self.current_index = index % len(STREAM_ITEMS)
        name, url = STREAM_ITEMS[self.current_index]
        self.mpv.play(url)
        self.current_name = name
        self.update_status()

    def on_button_pressed(self, event: Button.Pressed) -> None:
        if event.button.id == "prev":
            self.play_index(self.current_index - 1)
        elif event.button.id == "next":
            self.play_index(self.current_index + 1)

    def action_toggle_pause(self) -> None:
        if not self.mpv.is_playing:
            return
        self.mpv.toggle_pause()
        self.update_status()

    def action_stop(self) -> None:
        self.mpv.stop()
        self.current_name = None
        self.update_status()

    def action_quit(self) -> None:
        self.mpv.stop()
        self.exit()

    def on_unmount(self) -> None:
        self.mpv.stop()

    def update_status(self) -> None:
        status = self.query_one("#status", Static)
        if not self.mpv.is_playing:
            status.update("Nothing playing")
        elif self.mpv.paused:
            status.update(f"Paused: {self.current_name}")
        else:
            status.update(f"You are listening to {self.current_name}")


def main() -> None:
    RadioApp().run()


if __name__ == "__main__":
    main()
